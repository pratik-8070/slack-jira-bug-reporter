# Slack (create app at https://api.slack.com/apps, enable Socket Mode)
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-app-level-token   # needs connections:write
SLACK_SIGNING_SECRET=your-signing-secret

# Restrict the /report command to this channel only
DIAMOND_CHANNEL_ID=C0XXXXXXX

# Jira Cloud
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=your-jira-api-token
JIRA_PROJECT_KEY=DIAM
JIRA_ISSUE_TYPE=Bug
